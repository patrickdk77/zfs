"""
Split the ZTS runfiles into runfiles for parallel runners plus one
runfile of tests that must run alone.

zts-parallel.py --runfiles A.run,B.run --list parallel.tsv
    --tags TAG,TAG --runners N|auto --outdir DIR

Writes DIR/par-<i>.<runfile> for each runner and DIR/serial.<runfile>,
and prints the comma separated runfile lists, one line per runner and
a last line for the serial run.  With auto, the runner count is the
smallest of the online CPUs, the available memory divided by
ZTS_RUNNER_MEM MiB (default 4096), and ZTS_RUNNER_MAX (default 8).
"""

import argparse
import heapq
import os
import re
import sys

SECTION = re.compile(r'^\[([^\]]+)\]\n(.*?)(?=^\[|\Z)', re.M | re.S)
TESTS = re.compile(r'^tests\s*=\s*\[(.*?)\]', re.M | re.S)
TAGS = re.compile(r'^tags\s*=\s*\[(.*?)\]', re.M | re.S)
NAME = re.compile(r"'([^']+)'")


def parse(path):
    text = open(path).read()
    head = text[:text.find('[tests/')]
    secs = []
    for name, body in SECTION.findall(text):
        if name == 'DEFAULT':
            continue
        t = TESTS.search(body)
        g = TAGS.search(body)
        secs.append((name, body,
                     NAME.findall(t.group(1)) if t else [],
                     NAME.findall(g.group(1)) if g else []))
    return head, secs


def load_list(path):
    cls = {}
    for line in open(path):
        if line.startswith('#') or not line.strip():
            continue
        f = line.rstrip('\n').split('\t')
        cls[f[0]] = (f[1], int(f[2]))
    return cls


def available_memory():
    try:
        for line in open('/proc/meminfo'):
            if line.startswith('MemAvailable:'):
                return int(line.split()[1]) * 1024
    except OSError:
        pass
    page = os.sysconf('SC_PAGE_SIZE')
    try:
        return os.sysconf('SC_AVPHYS_PAGES') * page
    except (ValueError, OSError):
        return os.sysconf('SC_PHYS_PAGES') * page


def auto_runners():
    cpus = os.cpu_count() or 1
    mem = available_memory()
    per = int(os.environ.get('ZTS_RUNNER_MEM', '4096')) << 20
    cap = int(os.environ.get('ZTS_RUNNER_MAX', '8'))
    n = max(1, min(cpus, mem // per, cap))
    sys.stderr.write('zts-parallel: %d runners (%d CPUs, %.1f GiB '
                     'available, %d MiB per runner, max %d)\n' %
                     (n, cpus, mem / (1 << 30), per >> 20, cap))
    return n


def section_text(name, body, tests):
    names = ', '.join("'%s'" % t for t in tests)
    return '[%s]\n%s' % (name, TESTS.sub(
        lambda m: 'tests = [%s]' % names, body, count=1))


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('--runfiles', required=True)
    ap.add_argument('--list', required=True)
    ap.add_argument('--tags', default='functional')
    ap.add_argument('--runners', default='auto')
    ap.add_argument('--outdir', required=True)
    a = ap.parse_args()

    if a.runners == 'auto':
        runners = auto_runners()
    else:
        runners = max(1, int(a.runners))
    want = set(a.tags.split(','))
    cls = load_list(a.list)
    files = [(p, *parse(p)) for p in a.runfiles.split(',')]

    par = []
    for path, head, secs in files:
        for name, body, tests, tags in secs:
            if not set(tags) & want:
                continue
            for t in tests:
                c, sec = cls.get(name + '/' + t, ('S', 30))
                if c == 'P':
                    par.append((sec, path, name, t))

    groups = {}
    for sec, path, name, t in par:
        g = groups.setdefault(name.split(':')[0], [0, []])
        g[0] += sec
        g[1].append((path, name, t))

    load = [(0, i) for i in range(runners)]
    owner = {}
    for total, key in sorted(((g[0], k) for k, g in groups.items()),
                             reverse=True):
        s, i = heapq.heappop(load)
        for item in groups[key][1]:
            owner[item] = i
        heapq.heappush(load, (s + total, i))

    os.makedirs(a.outdir, exist_ok=True)
    lists = [[] for _ in range(runners + 1)]
    for path, head, secs in files:
        base = os.path.basename(path)
        out = [[] for _ in range(runners + 1)]
        for name, body, tests, tags in secs:
            if not set(tags) & want:
                continue
            split = [[] for _ in range(runners + 1)]
            for t in tests:
                split[owner.get((path, name, t), runners)].append(t)
            for i, ts in enumerate(split):
                if ts:
                    out[i].append(section_text(name, body, ts))
        for i, secs_out in enumerate(out):
            if not secs_out:
                continue
            tag = 'serial' if i == runners else 'par-%d' % (i + 1)
            f = os.path.join(a.outdir, '%s.%s' % (tag, base))
            with open(f, 'w') as fh:
                fh.write(head)
                fh.write('\n'.join(secs_out))
            lists[i].append(f)
    for i in range(runners + 1):
        print(','.join(lists[i]))


if __name__ == '__main__':
    main()
